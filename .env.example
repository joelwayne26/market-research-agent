# ============================================
# Market Research Agent - Environment Variables
# Copy this to .env and fill in your values
# ============================================

# Database Configuration (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=market_research_db
POSTGRES_PORT=5433
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/market_research_db

# Application
APP_PORT=3000
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# AI/LLM Configuration (Optional - for AI features)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# Redis (Optional - for caching)
REDIS_PORT=6380
REDIS_URL=redis://localhost:6380

# Scraping Configuration
SCRAPING_USER_AGENT=MarketResearchAgent/1.0
MAX_CONCURRENT_REQUESTS=5
